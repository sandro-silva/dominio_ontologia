        <universidade:cargaHoraria rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">60</universidade:cargaHoraria>
    </owl:NamedIndividual>
    


    <!-- http://exemplo.org/universidade#Calculo1 -->

    <owl:NamedIndividual rdf:about="http://exemplo.org/universidade#Calculo1">
