    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://exemplo.org/universidade#Algoritmos -->

    <owl:NamedIndividual rdf:about="http://exemplo.org/universidade#Algoritmos">
        <rdf:type rdf:resource="http://exemplo.org/universidade#Disciplina"/>
        <universidade:cargaHoraria rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">80</universidade:cargaHoraria>
    </owl:NamedIndividual>
    


    <!-- http://exemplo.org/universidade#BancoDeDados -->

